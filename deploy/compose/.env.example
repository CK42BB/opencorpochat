# SPDX-License-Identifier: AGPL-3.0-only
# OpenCorpoChat configuration. Copy to `.env` and edit.
# Everything except OCPC_DOMAIN is optional for the minimal setup.
# Lines marked (full setup) are required by docker-compose.full.yml.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# The domain your team will use (DNS must point at this server).
OCPC_DOMAIN=chat.example.com
# Public URL; compose files derive it from OCPC_DOMAIN. Set explicitly for other setups.
# OCPC_PUBLIC_URL=https://chat.example.com
# PORT=8080
# HOST=0.0.0.0
# OCPC_DATA_DIR=/data
# Secret used for signing tokens. Auto-generated and saved in the data dir if unset.
# OCPC_SECRET=
# Link shown in the About dialog (AGPL section 13). Point it at your fork if you modify the code.
# OCPC_SOURCE_URL=https://github.com/opencorpochat/opencorpochat
# OCPC_LOG_LEVEL=info
# OCPC_MAX_UPLOAD_MB=100
# Set true when running behind a reverse proxy (Caddy/nginx) so client IPs are correct.
# OCPC_TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Database — SQLite in the data dir by default. Use Postgres for larger orgs.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://ocpc:password@postgres:5432/ocpc
# (full setup) Password for the bundled Postgres container:
POSTGRES_PASSWORD=change-me-postgres

# ---------------------------------------------------------------------------
# File storage — local disk by default. Any S3-compatible service works.
# ---------------------------------------------------------------------------
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=ocpc
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# (full setup) Credentials for the bundled MinIO container:
MINIO_ROOT_USER=ocpc
MINIO_ROOT_PASSWORD=change-me-minio-at-least-8-chars

# ---------------------------------------------------------------------------
# Email (invites, password resets, missed-message digests)
# ---------------------------------------------------------------------------
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM="OpenCorpoChat <chat@example.com>"

# ---------------------------------------------------------------------------
# Single sign-on (OpenID Connect)
# Redirect URI to register with your provider: https://<OCPC_DOMAIN>/api/v1/auth/oidc/callback
# ---------------------------------------------------------------------------
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_BUTTON_LABEL=Sign in with SSO
# OIDC_AUTO_CREATE=true
# OIDC_ALLOWED_DOMAINS=example.com

# ---------------------------------------------------------------------------
# Calls — TURN/STUN for NAT traversal, LiveKit for large meetings
# ---------------------------------------------------------------------------
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# (full setup) Shared secret, must match coturn's static-auth-secret. Generate: openssl rand -hex 32
TURN_SECRET=change-me-turn-secret
# STUN_URLS=stun:turn.example.com:3478
# LIVEKIT_URL=wss://livekit.example.com
# (full setup) LiveKit domain and keys. Generate the secret with: openssl rand -hex 32
LIVEKIT_DOMAIN=livekit.example.com
LIVEKIT_API_KEY=ocpc
LIVEKIT_API_SECRET=change-me-livekit-secret-at-least-32-characters

# ---------------------------------------------------------------------------
# Web Push (browser notifications). Auto-generated and saved if unset.
# Generate explicitly with: docker exec ocpc ocpc generate-vapid
# ---------------------------------------------------------------------------
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
