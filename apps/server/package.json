{
  "name": "@ocpc/server",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "ocpc": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@ocpc/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "kysely": "^0.29.7",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1153.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
