{
  "name": "opencorpochat",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted, open-source team chat for small organizations",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm build:shared && pnpm --parallel --filter @ocpc/shared --filter @ocpc/server --filter @ocpc/web dev",
    "build": "pnpm build:shared && pnpm --filter @ocpc/web build && pnpm --filter @ocpc/server build",
    "start": "node apps/server/dist/index.js",
    "test": "pnpm build:shared && pnpm -r test",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "node scripts/check-licenses.mjs",
    "build:shared": "pnpm --filter @ocpc/shared build",
    "cli": "pnpm --filter @ocpc/server cli"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
